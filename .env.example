# BolDukaan runtime secrets — copy to .env.local and fill in.
#
# GEMINI_API_KEY: the app's runtime key, used server-side (in /api/structure)
# to turn a voice transcript into a structured storefront. Get a free key from
# Google AI Studio: https://aistudio.google.com/apikey
# This is a server-only secret — it is never shipped to the browser. Never commit
# the real value.
GEMINI_API_KEY=

# DATABASE_URL: Neon Postgres connection string (M1 persistence + public pages).
# Free project at https://neon.tech. After setting this, run: npm run db:init
DATABASE_URL=

