# BolDukaan secrets — copy to .env.local and fill in. Never commit real values.

# --- M1: database (Neon Postgres) ---
# Free project at https://neon.tech. After setting this, run: npm run db:init
DATABASE_URL=

# --- M0: runtime structuring (Google Gemini, free tier) ---
# Server-only key used in /api/structure. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- M2: auth (Auth.js / NextAuth v5) ---
# Generate a secret with:  npx auth secret   (or any 32-byte base64 string)
AUTH_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- M3: billing (Razorpay subscriptions) ---
# https://dashboard.razorpay.com/ — use TEST keys in development.
# Pro is a recurring MONTHLY subscription, so all four are required to take
# payments (the plan id is not optional):
# RAZORPAY_PLAN_ID: a monthly ₹149 Plan you create in the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET: the secret set on your /api/razorpay/webhook endpoint
#   (subscribe to subscription.* events so renewals/cancellations sync).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Runtime flags (host env only; not secrets) ---
# Canonical public URL for sitemap/robots/OpenGraph. Defaults to
# https://boldukaan.com when unset; override per environment (e.g. previews).
NEXT_PUBLIC_SITE_URL=
# Pre-launch "Coming Soon" gate. ON unless explicitly "off". Set to off to go live.
COMING_SOON=on
# Master switch for the Pro upgrade/checkout. Off until Razorpay KYC is live.
BILLING_ENABLED=false
